#!/bin/sh
# daede-sysctl - 读取/写入 sysctl 参数
# GET: 返回当前所有参数 JSON
# POST: 写入参数并执行 sysctl -p

case "$REQUEST_METHOD" in
  GET)
    echo "Content-Type: application/json"
    echo ""
    sysctl -a 2>/dev/null | grep -E '^(fs\.file-max|net\.core\.somaxconn|net\.ipv4\.tcp_tw_reuse|net\.ipv4\.tcp_fin_timeout|vm\.swappiness|net\.ipv4\.icmp_echo_ignore_all)' | awk '{print $1 "=" $3}' | jq -R 'split("=") | {(.[0]): .[1]}' | jq -s 'add'
    ;;
  POST)
    echo "Content-Type: application/json"
    echo ""
    read -r input
    echo "$input" | jq -r 'to_entries[] | "\(.key)=\(.value)"' >> /etc/sysctl.conf
    sysctl -p
    echo '{"status":"ok"}'
    ;;
esac